#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly  buffer ValuesIn         { uint values[]; };
layout (std430, binding = 1) writeonly buffer BlockPrefixesOut { uint block_prefixes[]; };
layout (std430, binding = 2) writeonly buffer BlockTotalsOut   { uint block_totals[]; };

layout (push_constant) uniform PushConstants {
    uint n;
} params;

layout (local_size_x = GROUP_SIZE) in;

shared uint local_mem[GROUP_SIZE];

void main()
{
    const uint i  = gl_GlobalInvocationID.x;
    const uint gi = gl_LocalInvocationID.x;
    const uint wg = gl_WorkGroupID.x;

    local_mem[gi] = (i < params.n) ? values[i] : 0;
    barrier();

    for (uint d = 1; d < GROUP_SIZE; d <<= 1) {
        uint addend = 0;
        if (gi >= d) {
            addend = local_mem[gi - d];
        }
        barrier();
        local_mem[gi] += addend;
        barrier();
    }

    if (i < params.n) {
        block_prefixes[i] = local_mem[gi];
    }
    if (gi == GROUP_SIZE - 1) {
        block_totals[wg] = local_mem[gi];
    }
}
