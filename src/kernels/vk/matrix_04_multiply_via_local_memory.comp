#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer MatrixAIn   { float a[]; }; // rows=h x cols=k
layout (std430, binding = 1) readonly buffer MatrixBIn   { float b[]; }; // rows=k x cols=w
layout (std430, binding = 2)          buffer MatrixCOut  { float c[]; }; // rows=h x cols=w

layout (push_constant) uniform PushConstants {
    uint w;
    uint h;
    uint k;
} params;

shared float local_a[32 * 32], local_b[32 * 32];

layout (local_size_x = 32, local_size_y = 32) in;
void main()
{
    const uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    const uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;

    float sum = 0.0;
    for (uint i = 0; i < params.k; i += 32) {
        local_a[lx + 32 * ly] = (y < params.h && i + lx < params.k ? a[i + lx + y * params.k] : 0);
        local_b[lx + 32 * ly] = (x < params.w && i + ly < params.k ? b[(i + ly) * params.w + x] : 0);

        barrier();

        for (uint q = 0; q < 32; ++q) {
            sum += local_a[q + 32 * ly] * local_b[lx + 32 * q];
        }

        barrier();
    }

    if (x < params.w && y < params.h) {
        c[x + params.w * y] = sum;
    }
}
