#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer MatrixAIn   { float a[]; }; // rows=h x cols=k
layout (std430, binding = 1) readonly buffer MatrixBIn   { float b[]; }; // rows=k x cols=w
layout (std430, binding = 2)          buffer MatrixCOut  { float c[]; }; // rows=h x cols=w

layout (push_constant) uniform PushConstants {
    uint w;
    uint h;
    uint k;
} params;

shared float a_tile[TILE * TILE];
shared float b_tile[TILE * TILE];

layout (local_size_x = TILE, local_size_y = TILE) in;
void main()
{
    const uint lx = gl_LocalInvocationID.x;
    const uint ly = gl_LocalInvocationID.y;
    const uint gx = gl_GlobalInvocationID.x;
    const uint gy = gl_GlobalInvocationID.y;

    float acc = 0.0;
    for (uint t = 0; t < (params.k + TILE - 1) / TILE; t++) {
        const uint ax = t*TILE + lx;
        if (ax < params.k && gy < params.h) {
            a_tile[ly*TILE + lx] = a[gy*params.k + ax];
        } else {
            a_tile[ly*TILE + lx] = 0.0;
        }
        const uint by = t*TILE + ly;
        if (gx < params.w && by < params.k) {
            b_tile[ly*TILE + lx] = b[by*params.w + gx];
        } else {
            b_tile[ly*TILE + lx] = 0.0;
        }
        memoryBarrierShared();
        barrier();

        for (int i = 0; i < TILE; i++) {
            acc += a_tile[ly*TILE + i] * b_tile[i*TILE + lx];
        }
        memoryBarrierShared();
        barrier();
    }

    if (gx < params.w && gy < params.h) {
        c[gy*params.w + gx] = acc;
    }

}
