#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer  BlockPrefixesIn { uint block_prefixes[]; };
layout (std430, binding = 1) readonly buffer  TotalsPrefixIn  { uint totals_prefix[]; };
layout (std430, binding = 2) readonly buffer  BlockTotalsIn   { uint block_totals[]; };
layout (std430, binding = 3) writeonly buffer ResultOut       { uint result[]; };

layout (push_constant) uniform PushConstants {
    uint n;
} params;

layout (local_size_x = GROUP_SIZE) in;

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i < params.n) {
        const uint b = i / GROUP_SIZE;
        result[i] = block_prefixes[i] + totals_prefix[b] - block_totals[b];
    }
}
