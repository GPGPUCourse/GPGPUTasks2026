#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer Buffer1In  { uint arr[]; };
layout (std430, binding = 1)          buffer Buffer2Out { uint cnt[]; };

layout (push_constant) uniform PushConstants {
    uint n;
    uint bit;
} params;

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    const uint i = gl_GlobalInvocationID.x;

    if (i < params.n) {
        cnt[i] = (arr[i] & (1u << params.bit)) >> params.bit;
    } else {
        cnt[i] = 0;
    }
}
