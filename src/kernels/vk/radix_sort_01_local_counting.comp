#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) buffer Buffer1In  { uint inputs[]; };
layout (std430, binding = 1) buffer Buffer2Out { uint counts[]; };

layout (push_constant) uniform PushConstants {
    uint n;
    uint bit;
} params;

shared uint zeroes[GROUP_SIZE];

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    const uint wg = gl_WorkGroupID.x;
    const uint gi  = gl_GlobalInvocationID.x;
    const uint li = gl_LocalInvocationID.x;

    zeroes[li] = (gi < params.n) ? inputs[gi] & 1u << params.bit : 1;
    barrier();
    memoryBarrierShared();

    if (li == 0) {
        uint count = 0;
        for (int i = 0; i < GROUP_SIZE; i++) {
            count += zeroes[i] == 0 ? 1 : 0;
        }
        counts[wg] = (gi < params.n) ? count : 0;
    }
}
