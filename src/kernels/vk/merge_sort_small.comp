#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"
#include "merge.glsl"

layout (std430, binding = 0) readonly  buffer ValuesIn  { uint input_data[];  };
layout (std430, binding = 1) writeonly buffer ValuesOut { uint output_data[]; };

layout (push_constant) uniform PushConstants {
    int n;
} params;

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    const uint i = gl_GlobalInvocationID.x;
    const uint li = gl_LocalInvocationID.x;

    if (i < params.n) {
        merge_src[li] = input_data[i];
    } else {
        merge_src[li] = INF;
    }

    barrier();

    bool inverted = false;
    for (int len = 1; len <= 128; len *= 2, inverted = !inverted) {
        uint start = (li / (2 * len)) * (2 * len);
        merge(li, start, start + len, start + 2*len, inverted);
        barrier();
    }

    if (inverted && i < params.n) {
        output_data[i] = merge_dst[li];
    } else if (i < params.n) {
        output_data[i] = merge_src[li];
    }
}
