#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly   buffer OsIn  { uint offsets[]; };
layout (std430, binding = 1) readonly   buffer CsIn  { uint columns[]; };
layout (std430, binding = 2) readonly   buffer MsIn  { uint values[]; };
layout (std430, binding = 3) readonly   buffer VsIn  { uint vector[]; };
layout (std430, binding = 4) writeonly  buffer RsOut { uint result[]; };

layout (push_constant) uniform PushConstants {
    uint nrows;
} params;

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    const uint thread = gl_GlobalInvocationID.x;
    uint idx = thread*4;
    if (idx >= params.nrows) {
        return;
    }
    for (int t = 0; t < 4; t++) {
        uint p = offsets[idx];
        uint end = offsets[idx+1];
        uint col = columns[p];
        uint val = values[p];
        uint res = 0;

        while (p + 1 < end) {
            uint colN = columns[p+1];
            uint valN = values[p+1];

            res += val * vector[col];
            col = colN;
            val = valN;
            p++;
        }
        res += val * vector[col];
        result[idx++] = res;
    }
}
