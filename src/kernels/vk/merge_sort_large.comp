#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"
#include "merge.glsl"

layout (std430, binding = 0) readonly  buffer ValuesIn  { uint input_data[];  };
layout (std430, binding = 1) writeonly buffer ValuesOut { uint output_data[]; };

layout (push_constant) uniform PushConstants {
    int n;
    int sorted_length;
} params;

shared int a_beg, b_beg, a_end, b_end;

int part(int sum, int len_a, int len_b, int offset) {
    int l = max(0, sum - len_b);
    int r = min(sum, len_a);

    while (l <= r) {
        int a = (l + r) / 2;
        int b = sum - a;

        if (a > 0 && b < len_b && input_data[offset + a - 1] > input_data[offset + params.sorted_length + b]) {
            r = a - 1;
        } else if (b > 0 && a < len_a && input_data[offset + a] <= input_data[offset + params.sorted_length + b - 1]) {
            l = a + 1;
        } else {
            return a;
        }
    }
    return r;
}

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    const uint i = gl_GlobalInvocationID.x;
    const uint li = gl_LocalInvocationID.x;

    const uint buckets_cnt = 2 * params.sorted_length / GROUP_SIZE;
    const uint pair_idx = gl_WorkGroupID.x / buckets_cnt;
    const uint buck_in_pair = gl_WorkGroupID.x % buckets_cnt;

    const int pair_st = int(pair_idx) * 2 * params.sorted_length;
    const int before_cnt = int(buck_in_pair) * GROUP_SIZE;

    const int a_len = min(params.sorted_length, params.n - pair_st);
    const int b_len = min(params.sorted_length,
                            max(0, params.n - (pair_st + params.sorted_length)));
    const int end_cnt = min(before_cnt + GROUP_SIZE, a_len + b_len);
    if (li == 0) {
        a_beg = part(before_cnt, a_len, b_len, pair_st);
        b_beg = int(before_cnt) - a_beg;

        a_end = part(end_cnt, a_len, b_len, pair_st);
        b_end = end_cnt - a_end;
    }

    barrier();

    int cnt_a = a_end - a_beg;
    if (li < cnt_a) {
        merge_src[li] = input_data[pair_st + a_beg + li];
    } else if (li < end_cnt - before_cnt) {
        merge_src[li] = input_data[pair_st + params.sorted_length + b_beg + li - cnt_a];
    } else {
        merge_src[li] = INF;
    }

    barrier();

    merge(li, 0, cnt_a, GROUP_SIZE, false);

    barrier();

    if (i < params.n) {
        output_data[i] = merge_dst[li];
    }
}
