#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"
#include "../shared_structs/aabb_gpu_shared.h"
#include "../shared_structs/bvh_node_gpu_shared.h"

layout (std430, binding = 0) readonly buffer VerticesIn { float vertices[]; };
layout (std430, binding = 1) readonly buffer FacesIn    { uint faces[]; };
layout (std430, binding = 2) buffer MortonKeysBuf        { uint mortonKeys[]; };
layout (std430, binding = 3) buffer LeafTriIndicesOut   { uint leafTriIndices[]; };
layout (std430, binding = 4) buffer RefitCountersBuf     { uint refitCounters[]; };

layout (push_constant) uniform PushConstants
{
    uint nfaces;
    float cMinX;
    float cMinY;
    float cMinZ;
    float cMaxX;
    float cMaxY;
    float cMaxZ;
} params;

layout (local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

vec3 loadVertex(uint vi) {
    uint base = 3u * vi;
    return vec3(vertices[base + 0u], vertices[base + 1u], vertices[base + 2u]);
}

uvec3 loadFace(uint fi) {
    uint base = 3u * fi;
    return uvec3(faces[base + 0u], faces[base + 1u], faces[base + 2u]);
}

uint expandBits(uint v) {
    rassert(v == (v & 0x3FFu), 763894133u);
    v = (v * 0x00010001u) & 0xFF0000FFu;
    v = (v * 0x00000101u) & 0x0F00F00Fu;
    v = (v * 0x00000011u) & 0xC30C30C3u;
    v = (v * 0x00000005u) & 0x49249249u;
    return v;
}

uint morton3D(float x, float y, float z) {
    uint ix = uint(clamp(int(x * 1024.0f), 0, 1023));
    uint iy = uint(clamp(int(y * 1024.0f), 0, 1023));
    uint iz = uint(clamp(int(z * 1024.0f), 0, 1023));
    return (expandBits(ix) << 2) | (expandBits(iy) << 1) | expandBits(iz);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint N = params.nfaces;
    if (i >= N) return;

    uvec3 f = loadFace(i);
    vec3 c = (loadVertex(f.x) + loadVertex(f.y) + loadVertex(f.z)) * (1.0 / 3.0);

    vec3 cMin = vec3(params.cMinX, params.cMinY, params.cMinZ);
    vec3 cMax = vec3(params.cMaxX, params.cMaxY, params.cMaxZ);
    vec3 d = max(cMax - cMin, vec3(1e-9));
    vec3 n = clamp((c - cMin) / d, 0.0, 1.0);

    mortonKeys[i] = morton3D(n.x, n.y, n.z);
    leafTriIndices[i] = i;

    if (i < uint(max(0, int(N) - 1))) {
        refitCounters[i] = 0u;
    }
}
