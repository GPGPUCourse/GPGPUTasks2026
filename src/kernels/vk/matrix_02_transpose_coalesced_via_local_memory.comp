#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer MatrixIn   { float matrix[];            };
layout (std430, binding = 1)          buffer MatrixOut  { float transposed_matrix[]; };

layout (push_constant) uniform PushConstants {
    uint w;
    uint h;
} params;

shared float local[33 * 32];

layout (local_size_x = 32, local_size_y = 32) in;
void main()
{
    const uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    const uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;

    local[lx + 33 * ly] = (x < params.w && y < params.h ? matrix[x + params.w * y] : 0);

    barrier();

    const uint new_x = gl_WorkGroupID.y * gl_WorkGroupSize.y + lx, new_y = gl_WorkGroupID.x * gl_WorkGroupSize.x + ly;
    if (new_x < params.h && new_y < params.w) {
        transposed_matrix[new_x + new_y * params.h] = local[lx * 33 + ly];
    }
}
