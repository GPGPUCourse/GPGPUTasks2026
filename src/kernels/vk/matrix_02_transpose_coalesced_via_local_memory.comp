#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer MatrixIn   { float matrix[];            };
layout (std430, binding = 1)          buffer MatrixOut  { float transposed_matrix[]; };

layout (push_constant) uniform PushConstants {
    uint w;
    uint h;
} params;

shared float local_data[(GROUP_SIZE_X+1) * GROUP_SIZE_Y];

layout (local_size_x = GROUP_SIZE_X, local_size_y = GROUP_SIZE_Y) in;
void main()
{
    const uint lx = gl_LocalInvocationID.x;
    const uint ly = gl_LocalInvocationID.y;
    const uint gx = gl_GlobalInvocationID.x;
    const uint gy = gl_GlobalInvocationID.y;

    if (gx < params.w && gy < params.h) {
        const uint index = gy * params.w + gx;
        const uint local_index = ly * (GROUP_SIZE_X + 1) + lx;
        local_data[local_index] = matrix[index];
    }

    memoryBarrierShared();
    barrier();

    const uint ox = gl_WorkGroupID.y * GROUP_SIZE_Y + lx;
    const uint oy = gl_WorkGroupID.x * GROUP_SIZE_X + ly;
    if (ox < params.h && oy < params.w) {
        const uint index = oy * params.h + ox;
        const uint local_index = lx * (GROUP_SIZE_X + 1) + ly;
        transposed_matrix[index] = local_data[local_index];
    }
}
