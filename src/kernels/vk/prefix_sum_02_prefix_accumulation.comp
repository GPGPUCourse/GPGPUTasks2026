#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer MatrixAIn   { uint pow2_sum[]; }; // pow2_sum[i] = sum[i*2^pow2; (i+1)*2^pow2)
layout (std430, binding = 1)          buffer MatrixCOut  { uint c[]; }; // we want to make it finally so that prefix_sum_accum[i] = sum[0, i]

layout (push_constant) uniform PushConstants {
    uint n;
    uint pow2;
} params;

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    const uint i = gl_GlobalInvocationID.x;
    bool bitset = ((1 << params.pow2) & (i+1)) != 0;
    if (i < params.n && bitset) {
        c[i] += pow2_sum[(i+1 >> params.pow2) - 1];
    }
}
