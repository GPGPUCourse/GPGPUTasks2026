#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"
#include "../shared_structs/aabb_gpu_shared.h"

layout (std430, binding = 0) readonly buffer VerticesIn
{
    float vertices[];
};

layout (std430, binding = 1) readonly buffer FacesIn
{
    uint faces[];
};

layout (std430, binding = 2) buffer TriangleAABBsOut
{
    AABBGPU triangleAABBs[];
};

layout (std430, binding = 3) buffer CentroidsOut
{
    float centroids[];
};

layout (push_constant) uniform PushConstants
{
    uint nfaces;
} params;

layout (local_size_x = GROUP_SIZE) in;

vec3 loadVertex(uint vi)
{
    uint base = 3u * vi;
    return vec3(
        vertices[base + 0u],
        vertices[base + 1u],
        vertices[base + 2u]
    );
}

uvec3 loadFace(uint fi)
{
    uint base = 3u * fi;
    return uvec3(
        faces[base + 0u],
        faces[base + 1u],
        faces[base + 2u]
    );
}

float min3f(float v0, float v1, float v2) {
    return min(min(v0, v1), v2);
}

float max3f(float v0, float v1, float v2) {
    return max(max(v0, v1), v2);
}

vec3 avg3(vec3 v0, vec3 v1, vec3 v2) {
    return vec3(
        (v0.x + v1.x + v2.x) / 3.0,
        (v0.y + v1.y + v2.y) / 3.0,
        (v0.z + v1.z + v2.z) / 3.0
    );
}

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= params.nfaces) { return; }

    uvec3 face = loadFace(i);
    vec3 v0 = loadVertex(face.x);
    vec3 v1 = loadVertex(face.y);
    vec3 v2 = loadVertex(face.z);

    triangleAABBs[i].min_x = min3f(v0.x, v1.x, v2.x);
    triangleAABBs[i].min_y = min3f(v0.y, v1.y, v2.y);
    triangleAABBs[i].min_z = min3f(v0.z, v1.z, v2.z);

    triangleAABBs[i].max_x = max3f(v0.x, v1.x, v2.x);
    triangleAABBs[i].max_y = max3f(v0.y, v1.y, v2.y);
    triangleAABBs[i].max_z = max3f(v0.z, v1.z, v2.z);

    vec3 avg = avg3(v0, v1, v2);

    centroids[3*i+0] = avg.x;
    centroids[3*i+1] = avg.y;
    centroids[3*i+2] = avg.z;
}
