#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer InArray { uint arr[]; };
layout (std430, binding = 1) readonly buffer PrefSum  { uint pref[]; };
layout (std430, binding = 2) writeonly buffer OutArray { uint sorted[]; };

layout (push_constant) uniform PushConstants {
    uint n;
    uint bit;
} params;

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    const uint i = gl_GlobalInvocationID.x;

    if (i >= params.n) {
        return;
    }

    const uint num = arr[i];
    const uint val = num & (1u << params.bit);
    const uint before_i = i == 0 ? 0 : pref[i - 1];
    const uint cnt_ones = pref[params.n - 1];

    uint dest;
    if (val != 0) {
        dest = params.n - cnt_ones + before_i;
    } else {
        dest = i - before_i;
    }

    sorted[dest] = num;
}
