#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer InArray { uint arr[]; };
layout (std430, binding = 1) readonly buffer PrefSum  { uint pref[]; };
layout (std430, binding = 2) writeonly buffer OutArray { uint sorted[]; };

layout (push_constant) uniform PushConstants {
    uint n;
    uint bit;
} params;

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    const uint i = gl_GlobalInvocationID.x;

    if (i >= params.n) {
        return;
    }

    const uint num = arr[i];
    const uint digit = (num >> params.bit) & 3u;
    const uint before_i = i == 0 ? 0 : pref[digit * params.n + i - 1];

    uint bucket_start = 0;
    for (uint d = 0; d < digit; ++d) {
        bucket_start += pref[d * params.n + params.n - 1];
    }

    const uint dest = bucket_start + before_i;
    sorted[dest] = num;
}
