#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly  buffer ValuesIn  { uint vals_in[]; };
layout (std430, binding = 1) writeonly buffer ValuesOut { uint vals_out[]; };

layout (push_constant) uniform PushConstants {
    uint n;
} params;

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < params.n) {
        vals_out[i] = vals_in[i];
    }
}
