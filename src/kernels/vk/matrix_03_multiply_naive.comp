#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer MatrixAIn   { float a[]; }; // rows=h x cols=k
layout (std430, binding = 1) readonly buffer MatrixBIn   { float b[]; }; // rows=k x cols=w
layout (std430, binding = 2)          buffer MatrixCOut  { float c[]; }; // rows=h x cols=w

layout (push_constant) uniform PushConstants {
    uint w;
    uint h;
    uint k;
} params;

layout (local_size_x = GROUP_SIZE_X, local_size_y = GROUP_SIZE_Y) in;
void main()
{
    if (gl_GlobalInvocationID.y >= params.h || gl_GlobalInvocationID.x >= params.w) {
        return;
    }
    float acc = 0.0;
    for (int i = 0; i < params.k; i++) {
        acc += a[gl_GlobalInvocationID.y*params.k + i] * b[i*params.w + gl_GlobalInvocationID.x];
    }

    const uint index = gl_GlobalInvocationID.y * params.w + gl_GlobalInvocationID.x;
    c[index] = acc;
}
