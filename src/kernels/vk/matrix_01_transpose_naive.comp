#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer MatrixIn   { float matrix[];            };
layout (std430, binding = 1)          buffer MatrixOut  { float transposed_matrix[]; };

layout (push_constant) uniform PushConstants {
    uint w;
    uint h;
} params;

layout (local_size_x = GROUP_SIZE_X, local_size_y = GROUP_SIZE_Y) in;
void main()
{
    if (gl_GlobalInvocationID.y >= params.h || gl_GlobalInvocationID.x >= params.w) {
        return;
    }
    const uint index = gl_GlobalInvocationID.y * params.w + gl_GlobalInvocationID.x;
    const uint transposed_index = gl_GlobalInvocationID.x * params.h + gl_GlobalInvocationID.y;
    transposed_matrix[transposed_index] = matrix[index];
}
