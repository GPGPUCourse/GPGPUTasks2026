#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

// we want to make it finally so that prefix_sum_accum[i] = sum[0, i]
layout (std430, binding = 0) readonly  buffer SumIn   { uint sum_in[]; };
layout (std430, binding = 1) writeonly buffer SumOut  { uint sum_out[]; };

layout (push_constant) uniform PushConstants {
    uint n;
    uint st_pow;
} params;

shared uint local_buffer[GROUP_SIZE];

uint GetBlockIndex(uint global_idx) {
    return min((global_idx + 1) << params.st_pow, params.n) - 1;
}

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    const uint idx = gl_GlobalInvocationID.x;
    const uint local_idx = gl_LocalInvocationID.x;
    const uint group_start = gl_WorkGroupID.x * GROUP_SIZE;
    const uint block_idx = GetBlockIndex(idx);
    const uint cur_size = (params.n + (1 << params.st_pow) - 1) >> params.st_pow;

    if (idx < cur_size) {
        local_buffer[local_idx] = sum_in[block_idx];
    } else {
        local_buffer[local_idx] = 0;
    }
    barrier();

    if (local_idx == 0) {
        for (uint k = 1; k < GROUP_SIZE && group_start + k < cur_size; ++k) {
            local_buffer[k] += local_buffer[k - 1];
        }
    }
    barrier();


    if (idx < cur_size) {
        sum_out[GetBlockIndex(idx)] = local_buffer[local_idx];
    }
}
