#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly  buffer SumIn   { uint sum_in[]; };
layout (std430, binding = 1) writeonly buffer SumOut  { uint sum_out[]; };

layout (push_constant) uniform PushConstants {
    uint n;
    uint st_pow;
    uint bit;
} params;

shared uint local_buffer[4][GROUP_SIZE];

uint GetBlockIndex(uint global_idx) {
    return min((global_idx + 1) << params.st_pow, params.n) - 1;
}

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    const uint idx = gl_GlobalInvocationID.x;
    const uint local_idx = gl_LocalInvocationID.x;
    const uint group_start = gl_WorkGroupID.x * GROUP_SIZE;
    const uint block_idx = GetBlockIndex(idx);
    const uint cur_size = (params.n + (1 << params.st_pow) - 1) >> params.st_pow;

    uvec4 val = uvec4(0);
    if (idx < cur_size) {
        if (params.st_pow == 0) {
            const uint digit = (sum_in[block_idx] >> params.bit) & 3u;
            val[digit] = 1u;
        } else {
            val = uvec4(sum_in[block_idx], sum_in[params.n + block_idx],
                        sum_in[2u * params.n + block_idx],
                        sum_in[3u * params.n + block_idx]);
        }
    }
    for (uint d = 0; d < 4; ++d) {
        local_buffer[d][local_idx] = val[d];
    }
    barrier();

    if (local_idx == 0) {
        for (uint k = 1; k < GROUP_SIZE && group_start + k < cur_size; ++k) {
            for (uint d = 0; d < 4; ++d) {
                local_buffer[d][k] += local_buffer[d][k - 1];
            }
        }
    }
    barrier();


    if (idx < cur_size) {
        for (uint d = 0; d < 4; ++d) {
            sum_out[d * params.n + block_idx] = local_buffer[d][local_idx];
        }
    }
}
