#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) buffer Buffer1In  { uint counts[]; };

layout (push_constant) uniform PushConstants {
    uint stride;
    uint count;
} params;

layout (local_size_x = GROUP_SIZE) in;
void main()
{
    if (gl_GlobalInvocationID.x >= params.count) { return; }
    const uint i = gl_GlobalInvocationID.x * params.stride;
    counts[i] += counts[i + params.stride/2];
}
