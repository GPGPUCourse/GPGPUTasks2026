{
    "version": 8,
    "configurePresets": [
        {
            "name": "Clang 21.0.0 arm64-apple-darwin25.6.0",
            "displayName": "Clang 21.0.0 arm64-apple-darwin25.6.0",
            "description": "Using compilers: C = /usr/bin/clang, CXX = /usr/bin/clang++",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-I/opt/homebrew/opt/libomp/include",
                "CMAKE_CXX_STANDARD_LIBRARIES": "/opt/homebrew/opt/libomp/lib/libomp.dylib",
                "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/libomp",
                "OpenMP_C_INCLUDE_DIR": "/opt/homebrew/opt/libomp/include",
                "OpenMP_CXX_INCLUDE_DIR": "/opt/homebrew/opt/libomp/include"
            }
        }
    ]
}
